# --- required ---
# Postgres connection string. Local example below; on Render/Railway/Neon/Supabase paste the one they give you.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dike

# --- optional ---
PORT=3000
NODE_ENV=development

# The account with this email becomes the admin (can read the contact inbox).
# If empty, the first account ever created becomes the admin.
ADMIN_EMAIL=

# Set to true if your Postgres provider requires SSL (Neon, Supabase, Render external URLs, Heroku).
PGSSL=false

# If true, anonymous visitors can see the repository on the landing page. If false, only signed-in users can.
PUBLIC_REPOSITORY=true

# Run db/schema.sql automatically when the server starts.
AUTO_MIGRATE=true

# Without a key, Research and the chat assistant fall back to simple keyword matching.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
